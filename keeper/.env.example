# ── chains ─────────────────────────────────────────────────────────────────
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# ── wallet (fund with a little ETH on Robinhood Chain + BNB on BNB Chain for gas)
KEEPER_PRIVATE_KEY=0x...

# ── addresses ──────────────────────────────────────────────────────────────
# $SOL token on Robinhood Chain (from PONS after launch)
TOKEN_ADDRESS=
# canonical WETH on Robinhood Chain (verified)
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# treasury wallet (receives 30% + the first-10-min war chest)
TREASURY_ADDRESS=
# BatchDistributor deployed on BNB Chain (forge script script/DeployDistributor.s.sol)
DISTRIBUTOR_ADDRESS=
# comma-separated: PONS pool/pair, lockers, anything that must never receive rewards
EXCLUDED_ADDRESSES=
# PONS contract to claim creator fees from — see docs/PONS.md
PONS_FEE_CONTRACT=

# ── schedule / economics ───────────────────────────────────────────────────
# ISO time of launch; the war-chest phase is measured from this moment
LAUNCH_AT=2026-09-01T00:00:00Z
# block number of launch — Transfer indexing starts here
LAUNCH_BLOCK=0
TREASURY_PHASE_MINUTES=10
REWARDS_BPS=7000
RUN_INTERVAL_MINUTES=30
MIN_WETH_TO_PROCESS_WEI=5000000000000000
MIN_BNB_PER_HOLDER_WEI=100000000000000
MIN_TOKEN_BALANCE_WEI=0
BATCH_SIZE=200
BRIDGE_SLIPPAGE=0.01

# ── stats publishing ───────────────────────────────────────────────────────
# uncomment to auto-commit stats.json into the site (feeds the live dashboard)
# SITE_PUBLISH_PATH=/home/ubuntu/SOL_RH/site/public/stats.json
