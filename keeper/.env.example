# ── chains ─────────────────────────────────────────────────────────────────
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# ── wallet ─────────────────────────────────────────────────────────────────
# The keeper wallet LAUNCHES the token (it must be the PONS deployer to sweep
# fees) and claims/bridges/distributes. Fund it with a little ETH on Robinhood
# Chain (launch fee 0.0005 + gas) and ~0.05 BNB on BNB Chain (distribution gas).
KEEPER_PRIVATE_KEY=0x...

# ── addresses ──────────────────────────────────────────────────────────────
# $SOL token on Robinhood Chain — printed by `node src/launch.ts`
TOKEN_ADDRESS=
# treasury wallet (receives 30% + the first-10-min war chest, in ETH)
TREASURY_ADDRESS=
# BatchDistributor deployed on BNB Chain (forge script script/DeployDistributor.s.sol)
DISTRIBUTOR_ADDRESS=
# extra never-pay addresses, comma-separated (curve/hook/escrow/locker are auto-excluded)
EXCLUDED_ADDRESSES=

# PONS V2 contracts — verified mainnet defaults are baked in (docs/PONS.md);
# only override if PONS migrates:
# PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# PONS_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044

# ── schedule / economics ───────────────────────────────────────────────────
# ISO time + block of launch — both printed by launch.ts
LAUNCH_AT=2026-09-01T00:00:00Z
LAUNCH_BLOCK=0
TREASURY_PHASE_MINUTES=10
REWARDS_BPS=7000
RUN_INTERVAL_MINUTES=30
MIN_ETH_TO_PROCESS_WEI=5000000000000000
GAS_RESERVE_WEI=2000000000000000
MIN_BNB_PER_HOLDER_WEI=100000000000000
MIN_TOKEN_BALANCE_WEI=0
BATCH_SIZE=200
BRIDGE_SLIPPAGE=0.01

# ── stats publishing ───────────────────────────────────────────────────────
# uncomment to auto-commit stats.json into the site (feeds the live dashboard)
# SITE_PUBLISH_PATH=/home/ubuntu/SOL_RH/site/public/stats.json
